<?xml version="1.0" encoding="utf-8"?>
<!-- the app's own button: blue-tinted rounded (the system default is grey) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33808080">
    <item>
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/btn_bg" />
                <stroke android:width="1dp" android:color="@color/btn_stroke" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</ripple>
