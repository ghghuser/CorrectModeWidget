<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No system action bar: every screen draws its own header (see Ui.screen) and handles the system bars
         itself, because Android 15+ forces edge-to-edge. The background is a faint blue gradient. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:timePickerDialogTheme">@style/AppDialog</item>
    </style>

    <!-- the look editor window: a full screen with the same blue background as the app -->
    <style name="LookDialog" parent="AppTheme" />

    <style name="AppButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- every pop-up (choices, questions, time picker): card colours of the app instead of system black / grey -->
    <style name="AppDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">#16315E</item>
        <item name="android:textColorSecondary">#43567A</item>
    </style>

    <!-- The profile wizard: a card floating over the main screen (see WizardActivity). -->
    <style name="WizardTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@drawable/wizard_bg</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Invisible host for the duration dialog / widget tap (own task, never stays on screen). -->
    <style name="TapTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
